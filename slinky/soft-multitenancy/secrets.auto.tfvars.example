# secrets.auto.tfvars.example
#
# Copy to secrets.auto.tfvars and fill in your values:
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# Terraform automatically loads *.auto.tfvars files, and *.auto.tfvars is
# gitignored in this repository, so secrets.auto.tfvars will never be committed.

# vCluster Platform API key.
# Create one in the Platform UI under Settings > Access Keys.
platform_access_key = ""
