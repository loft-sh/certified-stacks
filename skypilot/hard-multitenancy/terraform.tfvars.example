# Deployment name prefix
name = "skypilot"

# Host cluster
host_kubeconfig_path  = "~/.kube/config"
kubeconfig_output_dir = "."

# vCluster Platform
platform_url          = "https://platform.example.com"
platform_project_name = "default"

# Secrets -- do NOT put sensitive values in this file.
# Copy the secrets example and fill in your values:
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# Required: platform_access_key

# Auto Nodes — set node_provider_name and auto_node_properties for your cloud
# GCP example:
#   node_provider_name = "gcp-compute"
#   auto_node_properties = { project = "my-gcp-project", region = "us-central1" }
# AWS example:
#   node_provider_name = "aws-ec2"
#   auto_node_properties = { region = "us-east-1" }
node_provider_name   = ""
auto_node_properties = {}

# Node groups — cloud-specific instance types
# GCP example:
#   node_groups = {
#     dynamic = [
#       { name = "cpu-pool", node_types = ["gcp-compute.e2-standard-8"] },
#       { name = "gpu-pool", node_types = ["gcp-compute.n1-standard-4-t4", "gcp-compute.g2-standard-4"], limits = { nodes = 5 } }
#     ]
#   }
# AWS example:
#   node_groups = {
#     dynamic = [
#       { name = "cpu-pool", node_types = ["aws-ec2.m5.xlarge"] },
#       { name = "gpu-pool", node_types = ["aws-ec2.g4dn.xlarge", "aws-ec2.g6.xlarge"], limits = { nodes = 5 } }
#     ]
#   }

tenants = [
  {
    name = "tenant-1"
    # auth_credentials = "admin:$apr1$..."  # htpasswd string from: htpasswd -nb admin <password>
  }
]

# Optional: GPU Operator
# deploy_gpu_operator         = true
# gpu_operator_version        = "v25.10.1"
# gpu_operator_driver_enabled = true

# Optional: Monitoring (disabled by default)
# deploy_prometheus = false
# deploy_grafana    = false
