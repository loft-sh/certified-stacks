# Deployment name prefix
name = "runai"

# Host cluster
host_kubeconfig_path  = "~/.kube/config"
kubeconfig_output_dir = "."

# vCluster Platform
platform_url          = "https://platform.example.com"
platform_project_name = "default"

# Run:AI Control Plane
runai_cp_domain   = "runai-cp.10.0.0.1.nip.io"
runai_admin_email = "admin@run.ai"

# Secrets -- do NOT put sensitive values in this file.
# Copy the secrets example and fill in your values:
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# Required: platform_access_key, runai_registry_credentials
# Optional: runai_admin_password (auto-generated if omitted)

# Optional: Pre-reserved static IP for CP ingress (from dns-lb-setup module)
# cp_static_ip = "34.10.108.83"

# Agents
agents = [
  {
    name   = "agent-1"
    domain = "agent-1.10.0.0.1.nip.io"
  },
  {
    name   = "agent-2"
    domain = "agent-2.10.0.0.1.nip.io"
  }
]

# Agents with static IPs (from dns-lb-setup module)
# agents = [
#   {
#     name      = "agent-1"
#     domain    = "agent-1.34.10.108.84.nip.io"
#     static_ip = "34.10.108.84"
#   },
#   {
#     name      = "agent-2"
#     domain    = "agent-2.34.10.108.85.nip.io"
#     static_ip = "34.10.108.85"
#   }
# ]

# Optional: GPU Operator
# deploy_gpu_operator         = true
# gpu_operator_version        = "v25.10.1"
# gpu_operator_driver_enabled = true

# Optional: Prometheus Operator
# deploy_prometheus_operator    = true
# kube_prometheus_stack_version = "72.6.2"
